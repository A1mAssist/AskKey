<UserControl
    x:Class="AskKeyApp.CredentialsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp">
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="{StaticResource PageMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="SectionTitle" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock x:Name="SectionSubtitle" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button local:Loc.Key="Import from File" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                  Click="Import_Click"/>
          <Button local:Loc.Key="New Credential" Style="{StaticResource PrimaryButtonStyle}" Click="New_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Width="320" HorizontalAlignment="Left">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" TextChanged="Search_TextChanged"
                   local:Loc.Key="Search credentials…"/>
          <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" FontSize="13"
                     Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Left"
                     Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <ListView x:Name="CredentialList" Style="{StaticResource PlainListStyle}"
                    ItemContainerStyle="{StaticResource CredentialRowStyle}" SelectionChanged="CredentialList_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                          VerticalAlignment="Top">
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyphStyle}" Foreground="{ThemeResource AccentBrush}" FontSize="15"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadlineStyle}" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Run does not inherit TextBlock.FontFamily; keep inline text on the UI font. -->
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                      <Run FontFamily="{StaticResource UiFont}" Text="{Binding GroupName}"/><Run FontFamily="{StaticResource UiFont}" Text=" · "/><Run FontFamily="{StaticResource UiFont}" Text="{Binding PayloadKindLabel}"/>
                      <Run FontFamily="{StaticResource UiFont}" Text=" · "/><Run FontFamily="{StaticResource UiFont}" Text="{Binding ComponentCount}"/><Run FontFamily="{StaticResource UiFont}" local:Loc.Key=" items"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="8" Padding="7,3" VerticalAlignment="Top"
                          Background="{Binding Permission, Converter={StaticResource PermissionBrush}}">
                    <TextBlock Text="{Binding PermissionLabel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding Permission, Converter={StaticResource PermissionBrush}, ConverterParameter=text}"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="Collapsed" MaxWidth="280">
            <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyphStyle}" FontSize="22"
                         Foreground="{ThemeResource AccentBrush}"/>
            </Border>
            <TextBlock local:Loc.Key="No credentials yet" Style="{StaticResource HeadlineStyle}" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock local:Loc.Key="Create a credential or import a file. Agents can use it only after you approve."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button local:Loc.Key="New Credential" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"
                    HorizontalAlignment="Center" Click="New_Click"/>
          </StackPanel>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
          <Grid>
            <StackPanel x:Name="NoSelection" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock local:Loc.Key="Select a credential" Style="{StaticResource SecondaryTextStyle}"/>
            </StackPanel>

            <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" Style="{StaticResource ContentScrollViewerStyle}">
              <StackPanel Margin="20,18,20,20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="DetailName" Style="{StaticResource PageTitleStyle}" FontSize="21"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailSubtitle" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="EditButton" local:Loc.Key="Edit" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6" Margin="0,0,6,0" Click="Edit_Click"/>
                    <Button x:Name="DeleteButton" local:Loc.Key="Delete" Style="{StaticResource DangerButtonStyle}"
                            Padding="10,6" Click="Delete_Click"/>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource InsetCardStyle}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock x:Name="ProtectionNotice" Style="{StaticResource HeadlineStyle}" FontSize="12"/>
                    <TextBlock local:Loc.Key="The value is encrypted at rest and never returned to Agents in plaintext."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button x:Name="RevealButton" local:Loc.Key="Reveal" Style="{StaticResource SecondaryButtonStyle}"
                              Margin="0,0,6,0" Click="Reveal_Click"/>
                      <Button x:Name="CopyButton" local:Loc.Key="Copy" Style="{StaticResource PrimaryButtonStyle}"
                              Click="Copy_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock local:Loc.Key="VALUE" Style="{StaticResource SectionLabelStyle}" Margin="2,18,0,6"/>
                <Border Style="{StaticResource InsetCardStyle}" Padding="14,12">
                  <StackPanel>
                    <ItemsControl x:Name="ComponentList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SecondaryTextStyle}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource MonoTextStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding DeliveryText}" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RevealedValue" Style="{StaticResource MonoTextStyle}" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock local:Loc.Key="GROUP" Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox x:Name="GroupCombo" Style="{StaticResource FormComboBoxStyle}"
                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                              SelectionChanged="GroupCombo_SelectionChanged"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock local:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox x:Name="PermissionCombo" Style="{StaticResource FormComboBoxStyle}"
                              HorizontalAlignment="Stretch" Margin="0,6,0,0"
                              SelectionChanged="PermissionCombo_SelectionChanged">
                      <ComboBoxItem local:Loc.Key="Allow" Tag="allowed"/>
                      <ComboBoxItem local:Loc.Key="Ask" Tag="ask"/>
                      <ComboBoxItem local:Loc.Key="Hidden" Tag="hidden"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Border x:Name="TimedAllowanceCard" Style="{StaticResource InsetCardStyle}" Margin="0,14,0,0"
                        Visibility="Collapsed">
                  <Grid>
                    <TextBlock x:Name="TimedAllowanceText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <Button local:Loc.Key="Revoke now" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"
                            Click="RevokeAllowance_Click"/>
                  </Grid>
                </Border>

                <StackPanel x:Name="InstructionsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                  <TextBlock local:Loc.Key="INSTRUCTIONS FOR AGENT" Style="{StaticResource SectionLabelStyle}"/>
                  <Border Style="{StaticResource InsetCardStyle}" Margin="0,6,0,0">
                    <TextBlock x:Name="InstructionsText" Style="{StaticResource BodyTextStyle}"/>
                  </Border>
                </StackPanel>

                <StackPanel x:Name="NotesPanel" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock local:Loc.Key="PRIVATE NOTES" Style="{StaticResource SectionLabelStyle}"/>
                  <Border Style="{StaticResource InsetCardStyle}" Margin="0,6,0,0">
                    <TextBlock x:Name="NotesText" Style="{StaticResource BodyTextStyle}"/>
                  </Border>
                </StackPanel>

                <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionTextStyle}" Margin="0,16,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </Grid>

    <Border x:Name="LockedPanel" Background="{ThemeResource WindowBackgroundBrush}" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
        <Border Width="52" Height="52" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}"
                HorizontalAlignment="Center">
          <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyphStyle}" FontSize="22"
                     Foreground="{ThemeResource AccentBrush}"/>
        </Border>
        <TextBlock local:Loc.Key="Unlock Ask Key" Style="{StaticResource PageTitleStyle}" FontSize="21"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
        <TextBlock local:Loc.Key="Confirm that you are the device owner to view and manage credentials."
                   Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
        <Button local:Loc.Key="Unlock management" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                HorizontalAlignment="Center" Click="Unlock_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
