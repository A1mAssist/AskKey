<Window
    x:Class="AskKeyApp.CredentialEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp"
    >
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Style="{StaticResource ContentScrollViewerStyle}">
      <StackPanel Margin="28,24,28,20">
        <TextBlock x:Name="TitleText" local:Loc.Key="New credential" Style="{StaticResource PageTitleStyle}" FontSize="23"/>
        <TextBlock x:Name="SubtitleText" local:Loc.Key="Keep the material an Agent needs together."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>

        <TextBlock local:Loc.Key="NAME" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}"/>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock local:Loc.Key="TYPE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeCombo" Style="{StaticResource FormComboBoxStyle}"
                      HorizontalAlignment="Stretch" SelectionChanged="Type_SelectionChanged">
              <ComboBoxItem local:Loc.Key="Text" Tag="text"/>
              <ComboBoxItem local:Loc.Key="File" Tag="file"/>
              <ComboBoxItem local:Loc.Key="Bundle" Tag="bundle"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock local:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="PermissionCombo" Style="{StaticResource FormComboBoxStyle}"
                      HorizontalAlignment="Stretch">
              <ComboBoxItem local:Loc.Key="Ask every time" Tag="ask"/>
              <ComboBoxItem local:Loc.Key="Allow" Tag="allowed"/>
              <ComboBoxItem local:Loc.Key="Hidden" Tag="hidden"/>
            </ComboBox>
          </StackPanel>
        </Grid>

        <TextBlock local:Loc.Key="GROUP" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,6"/>
        <ComboBox x:Name="GroupCombo" Style="{StaticResource FormComboBoxStyle}" IsEditable="True"
                  HorizontalAlignment="Stretch">
          <!-- The editable ComboBox hosts a stock TextBox that draws its own frame and focus underline; keep only the rounded ComboBox frame. -->
          <ComboBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </ComboBox.Resources>
        </ComboBox>

        <Border x:Name="ExistingSecretPanel" Style="{StaticResource InsetCardStyle}" Margin="0,20,0,0" Padding="14" Visibility="Collapsed">
          <Grid>
            <StackPanel>
              <TextBlock local:Loc.Key="Contents stay hidden" Style="{StaticResource HeadlineStyle}" FontSize="13"/>
              <TextBlock local:Loc.Key="Changing the name, group, permission or notes does not reveal plaintext."
                         Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button local:Loc.Key="Authenticate to edit contents" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Authenticate_Click"/>
          </Grid>
        </Border>

        <StackPanel x:Name="TextPanel" Margin="0,18,0,0">
          <TextBlock local:Loc.Key="VALUE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
          <Grid>
            <PasswordBox x:Name="ValueBox" Style="{StaticResource FormPasswordBoxStyle}"/>
            <TextBox x:Name="ValuePlainBox" Style="{StaticResource FormTextBoxStyle}" Visibility="Collapsed"/>
            <Button local:Loc.Key="Show" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,4,0" Click="ToggleValue_Click"/>
          </Grid>
          <TextBlock local:Loc.Key="ENVIRONMENT VARIABLE (OPTIONAL)" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,6"/>
          <TextBox x:Name="EnvironmentBox" Style="{StaticResource FormTextBoxStyle}"
                   local:Loc.ToolTipKey="For example: OPENAI_API_KEY"/>
        </StackPanel>

        <StackPanel x:Name="FilePanel" Margin="0,18,0,0" Visibility="Collapsed">
          <TextBlock local:Loc.Key="FILE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
          <Border Style="{StaticResource InsetCardStyle}" Padding="14">
            <Grid>
              <StackPanel>
                <TextBlock x:Name="FileNameText" local:Loc.Key="No file selected" Style="{StaticResource HeadlineStyle}" FontSize="13"/>
                <TextBlock x:Name="FileSizeText" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
              </StackPanel>
              <Button local:Loc.Key="Choose file" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Click="ChooseFile_Click"/>
            </Grid>
          </Border>
          <TextBlock local:Loc.Key="TEMPORARY FILE VARIABLE (OPTIONAL)" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,6"/>
          <TextBox x:Name="FileEnvironmentBox" Style="{StaticResource FormTextBoxStyle}"
                   local:Loc.ToolTipKey="For example: GOOGLE_APPLICATION_CREDENTIALS"/>
        </StackPanel>

        <StackPanel x:Name="BundlePanel" Margin="0,18,0,0" Visibility="Collapsed">
          <Grid>
            <TextBlock local:Loc.Key="COMPONENTS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button local:Loc.Key="Add text" Style="{StaticResource GhostButtonStyle}" Click="AddTextComponent_Click"/>
              <Button local:Loc.Key="Add file" Style="{StaticResource GhostButtonStyle}" Click="AddFileComponent_Click"/>
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="ComponentList" Margin="0,7,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource InsetCardStyle}" Padding="10" Margin="0,0,0,7">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Name, Mode=TwoWay}" Style="{StaticResource FormTextBoxStyle}" FontWeight="SemiBold"/>
                      <Button Grid.Column="1" local:Loc.Key="Remove" Style="{StaticResource GhostButtonStyle}"
                              Margin="8,0,0,0" Tag="{Binding}" Click="RemoveComponent_Click"/>
                    </Grid>
                    <TextBox Text="{Binding Value, Mode=TwoWay}" Style="{StaticResource FormTextBoxStyle}" Margin="0,7,0,0"
                             local:Loc.Key="Value" Visibility="{Binding TextVisibility}"/>
                    <Grid Margin="0,7,0,0" Visibility="{Binding FileVisibility}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding FileDescription}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" local:Loc.Key="Choose" Style="{StaticResource SecondaryButtonStyle}"
                              Tag="{Binding}" Click="ChooseComponentFile_Click"/>
                    </Grid>
                    <TextBox Text="{Binding Mapping, Mode=TwoWay}" Style="{StaticResource FormTextBoxStyle}" Margin="0,7,0,0"
                             local:Loc.Key="Environment variable or temporary-file variable"
                             local:Loc.ToolTipKey="Environment variable or temporary-file variable"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock local:Loc.Key="INSTRUCTIONS FOR AGENT (OPTIONAL)" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,6"/>
        <TextBox x:Name="InstructionsBox" Style="{StaticResource FormTextBoxStyle}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="58" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <TextBlock local:Loc.Key="PRIVATE NOTES (OPTIONAL)" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,6"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource FormTextBoxStyle}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="54" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <TextBlock local:Loc.Key="EXPIRY (OPTIONAL)" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,6"/>
        <TextBox x:Name="ExpiryBox" Style="{StaticResource FormTextBoxStyle}" local:Loc.ToolTipKey="YYYY-MM-DD"/>
        <TextBlock local:Loc.Key="Leave empty for no expiry. Ask Key hides expired credentials from Agents."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource WarningBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0"
            Background="{ThemeResource SurfaceBrush}" Padding="22,12">
      <Grid>
        <Button local:Loc.Key="Cancel" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" local:Loc.Key="Save credential" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Click="Save_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
