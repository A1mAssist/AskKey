<Window
    x:Class="AskKeyApp.ApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp"
    >
  <ScrollViewer Background="{ThemeResource WindowBackgroundBrush}" VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
  <Grid x:Name="RootGrid" Margin="24" Background="{ThemeResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock local:Loc.Key="Agent request" Style="{StaticResource PageTitleStyle}" FontSize="22"/>
        <TextBlock x:Name="RequesterText" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource InsetCardStyle}" VerticalAlignment="Top" Padding="10,7">
        <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionTextStyle}"/>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="18">
      <StackPanel>
        <TextBlock x:Name="ActionText" Style="{StaticResource HeadlineStyle}" FontSize="17" TextWrapping="Wrap"/>
        <Border x:Name="CommandCard" Style="{StaticResource InsetCardStyle}" Margin="0,14,0,0" Padding="12,10">
          <TextBlock x:Name="CommandText" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap"/>
        </Border>
        <TextBlock x:Name="WorkingDirectoryText" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
        <TextBlock x:Name="MappingsText" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Border x:Name="FileCard" Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18" Visibility="Collapsed">
      <StackPanel>
        <TextBlock local:Loc.Key="FROZEN FILE WRITE" Style="{StaticResource SectionLabelStyle}"/>
        <TextBlock x:Name="FileSummaryText" Style="{StaticResource BodyTextStyle}" Margin="0,7,0,0"/>
        <TextBlock x:Name="FileDigestText" Style="{StaticResource MonoTextStyle}" Margin="0,6,0,0"/>
        <TextBlock local:Loc.Key="The approved bytes are fixed to this digest. The Agent cannot substitute another file after approval."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FileRevealHint" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RevealFileButton" local:Loc.Key="View file" Style="{StaticResource GhostButtonStyle}" Click="RevealFile_Click"/>
            <Button x:Name="HideFileButton" local:Loc.Key="Hide file" Style="{StaticResource GhostButtonStyle}"
                    Visibility="Collapsed" Margin="4,0,0,0" Click="HideFile_Click"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="FileRevealBox" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" Visibility="Collapsed"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
        <TextBlock x:Name="FileRevealError" Foreground="{ThemeResource WarningBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <Button x:Name="DetailsButton" Grid.Row="3" Style="{StaticResource GhostButtonStyle}"
            HorizontalAlignment="Left" Margin="0,10,0,0" Click="Details_Click">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="DetailsChevron" Text="›" FontSize="15" Margin="0,0,5,0" VerticalAlignment="Center"/>
        <TextBlock local:Loc.Key="Details" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>

    <Border x:Name="DetailsCard" Grid.Row="4" Style="{StaticResource InsetCardStyle}" Margin="0,6,0,0" Padding="14" Visibility="Collapsed">
      <ScrollViewer Style="{StaticResource ContentScrollViewerStyle}" MaxHeight="300">
        <StackPanel x:Name="DetailsPanel">
          <StackPanel x:Name="DetailsRows"/>
          <Border x:Name="ValueRevealCard" Style="{StaticResource InsetCardStyle}" Margin="0,12,0,0" Padding="12" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <TextBlock local:Loc.Key="Value" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="RevealValueButton" local:Loc.Key="Authenticate to View" Style="{StaticResource GhostButtonStyle}" Click="RevealValue_Click"/>
                  <Button x:Name="HideValueButton" local:Loc.Key="Hide value" Style="{StaticResource GhostButtonStyle}"
                          Visibility="Collapsed" Margin="4,0,0,0" Click="HideValue_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ValueMaskedText" Text="••••••" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
              <TextBox x:Name="RevealedValueBox" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" Visibility="Collapsed"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
              <TextBlock x:Name="ValueRevealError" Foreground="{ThemeResource WarningBrush}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource InsetCardStyle}" Margin="0,12,0,0" Padding="12,10">
      <StackPanel>
        <TextBlock local:Loc.Key="Only approve a request you understand. Values stay hidden until you authenticate to view them."
                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
        <TextBlock local:Loc.Key="Close this window or press Esc to decide later."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="6" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button local:Loc.Key="Deny" Style="{StaticResource SecondaryButtonStyle}" Click="Deny_Click" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="TimedButton" local:Loc.Key="Allow for 30 minutes" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,8,0" Click="Timed_Click"/>
        <Button x:Name="AllowButton" local:Loc.Key="Allow once" Style="{StaticResource PrimaryButtonStyle}" Click="Allow_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
