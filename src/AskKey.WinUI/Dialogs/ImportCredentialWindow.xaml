<Window
    x:Class="AskKeyApp.ImportCredentialWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp"
    >
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Style="{StaticResource ContentScrollViewerStyle}">
      <StackPanel Margin="28,24,28,20">
        <TextBlock local:Loc.Key="Import from File" Style="{StaticResource PageTitleStyle}" FontSize="23"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>

        <TextBlock local:Loc.Key="NAME" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Name_TextChanged"/>
        <TextBlock local:Loc.Key="Defaults to the file name; you can change it."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>

        <StackPanel x:Name="PermissionPanel" Margin="0,18,0,0">
          <TextBlock local:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
          <ComboBox x:Name="PermissionCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Permission_SelectionChanged">
            <ComboBoxItem local:Loc.Key="Ask every time" Tag="ask"/>
            <ComboBoxItem local:Loc.Key="Allow" Tag="allowed"/>
            <ComboBoxItem local:Loc.Key="Hidden" Tag="hidden"/>
          </ComboBox>
        </StackPanel>
        <TextBlock x:Name="PermissionNote" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" Visibility="Collapsed"/>

        <Border x:Name="ConflictPanel" Style="{StaticResource InsetCardStyle}"
                Background="{ThemeResource WarningSoftBrush}" Margin="0,16,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="ConflictText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <RadioButton x:Name="SkipChoice" GroupName="ImportConflict" IsChecked="True"
                           VerticalAlignment="Center" Checked="ConflictChoice_Changed"/>
              <RadioButton x:Name="ReplaceChoice" GroupName="ImportConflict" Margin="18,0,0,0"
                           VerticalAlignment="Center" Checked="ConflictChoice_Changed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ContentsHeader" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,6"/>
        <Border Style="{StaticResource CardStyle}" Padding="10">
          <ItemsControl x:Name="RowList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock local:Loc.Key="COMPONENT" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}" Style="{StaticResource FormTextBoxStyle}" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ValueDisplay}" Style="{StaticResource MonoTextStyle}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="{Binding RevealLabel}" Tag="{Binding}" Click="RevealRow_Click"
                              Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Visibility="{Binding RevealVisibility}"/>
                    </Grid>
                    <TextBlock Text="{Binding MappingLabel}" Style="{StaticResource SectionLabelStyle}" Margin="0,9,0,5"/>
                    <TextBox Text="{Binding Mapping, Mode=TwoWay}" Style="{StaticResource FormTextBoxStyle}"
                             local:Loc.Key="Environment variable or temporary-file variable"
                             local:Loc.ToolTipKey="Environment variable or temporary-file variable"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock local:Loc.Key="The original file is never modified. Ask Key stores the imported material encrypted."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource WarningBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0"
            Background="{ThemeResource SurfaceBrush}" Padding="22,12">
      <Grid>
        <Button local:Loc.Key="Cancel" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" local:Loc.Key="Import as 1 credential" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Click="Save_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
