<Application
    x:Class="AskKeyApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:AskKeyApp">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <local:NullToVisibilityConverter x:Key="NullToVisibility" />
      <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility" />
      <local:CountToVisibilityConverter x:Key="CountToVisibility" />
      <local:PermissionLabelConverter x:Key="PermissionLabel" />
      <local:PermissionBadgeBrushConverter x:Key="PermissionBrush" />
      <local:PayloadKindLabelConverter x:Key="PayloadKindLabel" />
      <local:TimestampConverter x:Key="Timestamp" />
      <local:LocalTextOrFallbackConverter x:Key="LocalTextOrFallback" />
      <local:ByteCountConverter x:Key="ByteCount" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
