<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AskKey.Guard.Service</AssemblyName>
    <RootNamespace>AskKey.Guard.Service</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>..\AskKey.WinUI\Assets\AskKey.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AskKey.Guard\AskKey.Guard.csproj" />
  </ItemGroup>

</Project>
