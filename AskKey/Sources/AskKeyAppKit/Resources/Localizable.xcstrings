    "Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "每轮首次直接连接 SSH 前，提醒 Agent 查询凭证目录。使用凭证仍需审批。目录不可用或完成通知丢失时，连续 30 秒没有进展便停止拦截，避免任务一直卡住。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress.!!]" } }
      }
    },
