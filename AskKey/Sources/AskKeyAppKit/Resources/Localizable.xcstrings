    "Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在每轮首次直接运行 SSH 前，提醒 Codex 查询凭证目录。实际使用凭证仍按原有规则审批。检查不可用或超过三秒时，Codex 可能直接继续。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it.!!]" } }
