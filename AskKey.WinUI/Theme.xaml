                    <Setter Target="Knob.Margin" Value="0,0,4,0" />
                    <Setter Target="Track.Opacity" Value="0.8" />
                    <Setter Target="Root.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Track.Background" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="Knob.Fill" Value="{ThemeResource AccentTextBrush}" />
                    <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                    <Setter Target="Knob.Margin" Value="0,0,4,0" />
                    <Setter Target="Track.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="10" Background="{ThemeResource SurfaceMutedBrush}" />
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{ThemeResource TextPrimaryBrush}"
                       HorizontalAlignment="Left" Margin="4,0,0,0" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
