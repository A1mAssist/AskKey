<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="AskKey Guard"
           Manufacturer="AskKey"
           Version="$(var.ProductVersion)"
           Language="1033"
           Scope="perMachine"
           UpgradeCode="D755B70F-0F91-4E1B-9C92-F5C407252BC9">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AskKey Guard is already installed. Uninstall it before installing this version." />
    <MediaTemplate EmbedCab="yes" />
    <!-- WiX v6 Package has no icon attribute; the Add/Remove Programs icon comes from the
         MSI Icon table plus ARPPRODUCTICON, and both must be authored explicitly. -->
    <Icon Id="AskKeyIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AskKeyIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AskKeyProgramFilesDir" Name="AskKey">
        <Directory Id="GuardInstallDir" Name="Guard" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AskKeyProgramDataDir" Name="AskKey">
        <Directory Id="GuardDataDir" Name="Guard" />
      </Directory>
    </StandardDirectory>

    <Feature Id="GuardFeature" Title="AskKey Guard" Level="1">
      <Component Id="GuardServiceComponent" Directory="GuardInstallDir" Guid="{63545573-2116-48C8-89EE-451E6F7DA7C3}">
        <File Id="GuardServiceExe" Source="$(var.GuardPublishDir)\AskKey.Guard.Service.exe" KeyPath="yes" />
        <ServiceInstall Id="AskKeyGuardService"
                        Name="AskKeyGuard"
                        DisplayName="Ask Key Guard"
                        Description="Verifies Windows Hello signatures and releases the per-user Ask Key guard KEK."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Arguments="--service"
                        Vital="yes">
          <!-- Without this the service stays down after a crash and Hello unlock silently
               stops working; the PowerShell install path already sets failure actions. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              ResetPeriodInDays="1"
                              RestartServiceDelayInSeconds="5" />
        </ServiceInstall>
        <ServiceControl Id="AskKeyGuardServiceControl"
                        Name="AskKeyGuard"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Files Directory="GuardInstallDir" Include="$(var.GuardPublishDir)\**">
        <Exclude Files="$(var.GuardPublishDir)\AskKey.Guard.Service.exe" />
        <Exclude Files="$(var.GuardPublishDir)\**\*.pdb" />
      </Files>

      <Component Id="GuardDataComponent" Directory="GuardDataDir" Guid="{6A7206DD-D540-43D1-9DB5-47E40440EC86}" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;LS)" />
        </CreateFolder>
      </Component>
    </Feature>
  </Package>
</Wix>
