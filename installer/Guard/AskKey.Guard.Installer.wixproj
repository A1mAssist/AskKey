<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <OutputName>AskKeyGuard-$(ProductVersion)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- The publish directory is a required input: the default build tree also contains the
         RID-specific intermediate copy of the service, and the harvest below is recursive. -->
    <GuardPublishDir Condition="'$(GuardPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\AskKey.Guard-$(ProductVersion)-win-x64</GuardPublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);GuardPublishDir=$(GuardPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
