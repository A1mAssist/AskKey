<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle UpgradeCode="A7C44B2E-8B7E-4C6D-9B2A-2E6A0F6B4D11"
          Name="Ask Key"
          Version="$(var.ProductVersion)"
          Manufacturer="A1mAssist"
          DisableModify="yes"
          IconSourceFile="$(var.IconFile)">
    <BootstrapperApplication>
      <!-- rtfLicense, not hyperlinkLicense: the hyperlink themes bind LicenseUrl
           unconditionally and render only a link, so no license text would show. -->
      <!-- LogoFile is the supported way to swap the theme image; the WixStdbaLogo bind
           variable is internal and a Bundle-level WixVariable does not reach it. -->
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense"
                                              LicenseFile="$(var.LicenseFile)"
                                              LogoFile="$(var.BaLogo)" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="AskKeyApp"
                  SourceFile="$(var.AppMsi)"
                  Vital="yes"
                  Compressed="yes">
        <MsiProperty Name="VELOPACK_INSTALLDIR" Value="[ProgramFiles64Folder]AskKey" />
        <!-- Both MSIs are bundle payload. Without this each registers itself in Apps and
             Features too, so the user sees several Ask Key entries and can uninstall one
             half and leave the other behind. -->
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="1" />
      </MsiPackage>
      <MsiPackage Id="AskKeyGuard"
                  SourceFile="$(var.GuardMsi)"
                  Vital="yes"
                  Compressed="yes">
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="1" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
