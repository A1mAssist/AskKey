<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark counterpart of the WorkspaceVisualContract tokens. -->
  <Color x:Key="WindowBackgroundColor">#151719</Color>
  <Color x:Key="SidebarBackgroundColor">#1E2124</Color>
  <Color x:Key="SurfaceColor">#23262A</Color>
  <Color x:Key="SurfaceMutedColor">#2A2E33</Color>
  <Color x:Key="TextColor">#F2F3F5</Color>
  <Color x:Key="TextSecondaryColor">#AFB5BC</Color>
  <Color x:Key="TextTertiaryColor">#818890</Color>
  <Color x:Key="BorderColor">#3A3F45</Color>
  <Color x:Key="AccentColor">#7AA2FF</Color>
  <Color x:Key="AccentSoftColor">#243656</Color>
  <Color x:Key="WarningColor">#FF766C</Color>
  <Color x:Key="WarningSoftColor">#3A2423</Color>
  <Color x:Key="SuccessColor">#54D18C</Color>
  <Color x:Key="BorderStrongColor">#50575F</Color>
  <Color x:Key="HoverOverlayColor">#20FFFFFF</Color>
  <Color x:Key="SelectedSurfaceColor">#1C2638</Color>
  <Color x:Key="ToggleTrackColor">#4A5159</Color>
  <Color x:Key="ToggleThumbColor">#F4F5F7</Color>

  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}"/>
  <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}"/>
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceMuted" Color="{StaticResource SurfaceMutedColor}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}"/>
  <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="HoverOverlay" Color="{StaticResource HoverOverlayColor}"/>
  <SolidColorBrush x:Key="SelectedSurface" Color="{StaticResource SelectedSurfaceColor}"/>
  <SolidColorBrush x:Key="ToggleTrack" Color="{StaticResource ToggleTrackColor}"/>
  <SolidColorBrush x:Key="ToggleThumb" Color="{StaticResource ToggleThumbColor}"/>
</ResourceDictionary>