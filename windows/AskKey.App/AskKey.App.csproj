<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <HelperTargetFramework>net10.0-windows</HelperTargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AskKey</AssemblyName>
    <RootNamespace>AskKeyApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AskKey.Broker\AskKey.Broker.csproj" />
    <ProjectReference Include="..\AskKey.Helper\AskKey.Helper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AskKey.Integrations\AskKey.Integrations.csproj" />
    <ProjectReference Include="..\AskKey.System\AskKey.System.csproj" />
    <ProjectReference Include="..\AskKey.Vault\AskKey.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AskKeyApp.Tests" />
  </ItemGroup>

  <Target Name="CopyHelperToOutput" AfterTargets="Build">
    <PropertyGroup>
      <HelperOutputRoot>$(MSBuildProjectDirectory)\..\AskKey.Helper\bin\$(Configuration)\$(HelperTargetFramework)</HelperOutputRoot>
      <HelperOutputRoot Condition="'$(RuntimeIdentifier)' != ''">$(HelperOutputRoot)\$(RuntimeIdentifier)</HelperOutputRoot>
    </PropertyGroup>
    <ItemGroup>
      <HelperOutput Include="$(HelperOutputRoot)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(HelperOutput)" DestinationFolder="$(OutDir)Helpers\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyHelperToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <HelperPublishRoot>$(MSBuildProjectDirectory)\..\AskKey.Helper\bin\$(Configuration)\$(HelperTargetFramework)</HelperPublishRoot>
      <HelperPublishRoot Condition="'$(RuntimeIdentifier)' != ''">$(HelperPublishRoot)\$(RuntimeIdentifier)</HelperPublishRoot>
    </PropertyGroup>
    <ItemGroup>
      <HelperPublish Include="$(HelperPublishRoot)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(HelperPublish)" DestinationFolder="$(PublishDir)Helpers\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>



