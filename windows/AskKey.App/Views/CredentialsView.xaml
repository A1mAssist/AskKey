<UserControl x:Class="AskKeyApp.CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
             xmlns:vault="clr-namespace:AskKey.Vault;assembly=AskKey.Vault"
             FontFamily="{StaticResource UiFont}">
  <Grid Background="{DynamicResource WindowBackground}">
    <Grid Margin="30,26,30,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="SectionTitle" loc:Loc.Key="All credentials" Style="{StaticResource PageTitle}"/>
          <TextBlock x:Name="SectionSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"
                     loc:Loc.Key="Each credential is delivered and authorized as one complete set."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button loc:Loc.Key="Import from File" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                  Click="Import_Click"/>
          <Button loc:Loc.Key="New Credential" Style="{StaticResource PrimaryButton}" Click="New_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Width="320" HorizontalAlignment="Left">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged"/>
          <TextBlock x:Name="SearchPlaceholder" loc:Loc.Key="Search credentials…" IsHitTestVisible="False"
                     Foreground="{DynamicResource TextTertiary}" FontSize="13" Margin="34,0,0,0"
                     VerticalAlignment="Center"/>
          <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="13"
                     Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Left"
                     Margin="11,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <ListBox x:Name="CredentialList" Style="{StaticResource PlainListBox}"
                   ItemContainerStyle="{StaticResource CredentialRow}"
                   SelectionChanged="CredentialList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                          VerticalAlignment="Top">
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource Accent}"
                               FontSize="15"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Headline}" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding GroupName, TargetNullValue=Ungrouped, Mode=OneWay}"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding PayloadKind, Converter={StaticResource PayloadKindLabel}, Mode=OneWay}"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding ComponentCount, Mode=OneWay}"/>
                      <Run loc:Loc.Key=" items"/>
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="8" Padding="7,3" VerticalAlignment="Top">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Permission}" Value="{x:Static vault:CredentialPermission.Allowed}">
                            <Setter Property="Background" Value="{DynamicResource PermissionAllowedSoft}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Permission}" Value="{x:Static vault:CredentialPermission.Ask}">
                            <Setter Property="Background" Value="{DynamicResource PermissionAskSoft}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Permission, Converter={StaticResource PermissionLabel}}"
                               FontSize="10" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Permission}" Value="{x:Static vault:CredentialPermission.Allowed}">
                              <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Permission}" Value="{x:Static vault:CredentialPermission.Ask}">
                              <Setter Property="Foreground" Value="{DynamicResource PermissionAskText}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="Collapsed" MaxWidth="280">
            <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyph}" FontSize="22"
                         Foreground="{DynamicResource Accent}"/>
            </Border>
            <TextBlock loc:Loc.Key="No credentials yet" Style="{StaticResource Headline}" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock loc:Loc.Key="Create a credential or import a file. Agents can use it only after you approve."
                       Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button loc:Loc.Key="New Credential" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    HorizontalAlignment="Center" Click="New_Click"/>
          </StackPanel>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <StackPanel x:Name="NoSelection" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock loc:Loc.Key="Select a credential" Style="{StaticResource SecondaryText}"/>
            </StackPanel>

            <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" Style="{StaticResource ContentScrollViewer}">
              <StackPanel Margin="22,20,22,22">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="DetailName" Style="{StaticResource PageTitle}" FontSize="21"/>
                    <TextBlock x:Name="DetailSubtitle" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="EditButton" loc:Loc.Key="Edit" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,6,0" Click="Edit_Click"/>
                    <Button x:Name="DeleteButton" loc:Loc.Key="Delete" Style="{StaticResource DangerButton}"
                            Padding="10,6" Click="Delete_Click"/>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock loc:Loc.Key="Protected by Windows DPAPI" Style="{StaticResource Headline}" FontSize="12"/>
                      <TextBlock loc:Loc.Key="The value is encrypted at rest and never returned to Agents in plaintext."
                                 Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="RevealButton" loc:Loc.Key="Reveal" Style="{StaticResource SecondaryButton}"
                              Padding="10,6" Margin="0,0,6,0" Click="Reveal_Click"/>
                      <Button x:Name="CopyButton" loc:Loc.Key="Copy" Style="{StaticResource PrimaryButton}"
                              Padding="10,6" Click="Copy_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock loc:Loc.Key="VALUE" Style="{StaticResource SectionLabel}" Margin="2,18,0,6"/>
                <Border Style="{StaticResource InsetCard}" Padding="14,12">
                  <StackPanel>
                    <ItemsControl x:Name="ComponentList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SecondaryText}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource MonoText}"
                                       TextTrimming="CharacterEllipsis" Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding DeliveryText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RevealedValue" Style="{StaticResource MonoText}" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock loc:Loc.Key="GROUP" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="GroupCombo" Style="{StaticResource FormComboBox}" Width="220" DisplayMemberPath="Label"
                              HorizontalAlignment="Left" Margin="0,6,0,0"
                              SelectionChanged="GroupCombo_SelectionChanged"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock loc:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"/>
                    <ListBox x:Name="PermissionList" Style="{StaticResource SegmentList}" Width="260"
                             Margin="0,6,0,0" SelectionChanged="PermissionList_SelectionChanged">
                      <ListBoxItem loc:Loc.Key="Allow"/>
                      <ListBoxItem loc:Loc.Key="Ask"/>
                      <ListBoxItem loc:Loc.Key="Hidden"/>
                    </ListBox>
                  </StackPanel>
                </Grid>

                <Border x:Name="TimedAllowanceCard" Style="{StaticResource InsetCard}" Margin="0,14,0,0"
                        Visibility="Collapsed">
                  <Grid>
                    <TextBlock x:Name="TimedAllowanceText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <Button loc:Loc.Key="Revoke now" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Click="RevokeAllowance_Click"/>
                  </Grid>
                </Border>

                <StackPanel x:Name="InstructionsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                  <TextBlock loc:Loc.Key="INSTRUCTIONS FOR AGENT" Style="{StaticResource SectionLabel}"/>
                  <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
                    <TextBlock x:Name="InstructionsText" Style="{StaticResource BodyText}"/>
                  </Border>
                </StackPanel>

                <StackPanel x:Name="NotesPanel" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock loc:Loc.Key="PRIVATE NOTES" Style="{StaticResource SectionLabel}"/>
                  <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
                    <TextBlock x:Name="NotesText" Style="{StaticResource BodyText}"/>
                  </Border>
                </StackPanel>

                <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="LockedPanel" Background="{DynamicResource WindowBackground}" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
        <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                HorizontalAlignment="Center">
          <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="22"
                     Foreground="{DynamicResource Accent}"/>
        </Border>
        <TextBlock loc:Loc.Key="Unlock Ask Key" Style="{StaticResource PageTitle}" FontSize="21"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
        <TextBlock loc:Loc.Key="Confirm that you are the device owner to view and manage credentials."
                   Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
        <Button loc:Loc.Key="Unlock management" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                HorizontalAlignment="Center" Click="Unlock_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
