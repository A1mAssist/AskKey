<UserControl x:Class="AskKeyApp.AgentAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
             FontFamily="{StaticResource UiFont}">
  <Grid Background="{DynamicResource WindowBackground}">
    <ScrollViewer Style="{StaticResource ContentScrollViewer}">
      <StackPanel Margin="30,26,30,26" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock loc:Loc.Key="Agent access" Style="{StaticResource PageTitle}"/>
        <TextBlock loc:Loc.Key="Let a local Agent discover and use only the credentials you approve."
                   Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="8" Background="{DynamicResource AccentSoft}">
              <TextBlock x:Name="StatusIcon" Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="20"
                         Foreground="{DynamicResource Accent}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
              <TextBlock x:Name="StatusTitle" loc:Loc.Key="Agent access is running" Style="{StaticResource Headline}" FontSize="15"/>
              <TextBlock x:Name="StatusDetail" loc:Loc.Key="The local Broker is ready for approved requests."
                         Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="PauseButton" Grid.Column="2" loc:Loc.Key="Pause Agent access"
                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="Pause_Click"/>
          </Grid>
        </Border>

        <Border x:Name="BrokerFailurePanel" Style="{StaticResource InsetCard}" Background="{DynamicResource WarningSoft}"
                Margin="0,12,0,0" Visibility="Collapsed">
          <Grid>
            <TextBlock x:Name="BrokerFailureText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <Button loc:Loc.Key="Retry Broker" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Click="RetryBroker_Click"/>
          </Grid>
        </Border>

        <TextBlock loc:Loc.Key="AUTOMATIC SETUP" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <TextBlock loc:Loc.Key="Connect an installed client without copying configuration. Ask Key writes only its own MCP server and discovery hook, keeps a backup, then verifies both."
                       Style="{StaticResource SecondaryText}" Margin="18,16,18,4" TextWrapping="Wrap"/>

            <Grid Margin="18,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="C" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="Claude Code" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="ClaudeDetailText" loc:Loc.Key="MCP server and credential discovery" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
              </StackPanel>
              <TextBlock x:Name="ClaudeStatusText" loc:Loc.Key="Not checked" Grid.Column="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
              <Button x:Name="ClaudeButton" loc:Loc.Key="Connect" Grid.Column="3" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="ConnectClaude_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>

            <Grid Margin="18,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="X" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="Codex" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="CodexDetailText" loc:Loc.Key="MCP server and credential discovery" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
              </StackPanel>
              <TextBlock x:Name="CodexStatusText" loc:Loc.Key="Not checked" Grid.Column="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
              <Button x:Name="CodexButton" loc:Loc.Key="Connect" Grid.Column="3" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="ConnectCodex_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>

            <Grid Margin="18,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="C" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="Cursor" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="CursorDetailText" loc:Loc.Key="MCP server and credential discovery" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
              </StackPanel>
              <TextBlock x:Name="CursorStatusText" loc:Loc.Key="Not checked" Grid.Column="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
              <Button x:Name="CursorButton" loc:Loc.Key="Connect" Grid.Column="3" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="ConnectCursor_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>

            <Grid Margin="18,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="G" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="Grok CLI" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="GrokDetailText" loc:Loc.Key="MCP server and credential discovery" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
              </StackPanel>
              <TextBlock x:Name="GrokStatusText" loc:Loc.Key="Not checked" Grid.Column="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
              <Button x:Name="GrokButton" loc:Loc.Key="Connect" Grid.Column="3" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="ConnectGrok_Click"/>
            </Grid>

            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="18,12">
              <TextBlock loc:Loc.Key="Restart an open client after connecting." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
              <Button loc:Loc.Key="Check connections" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="CheckConnections_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock loc:Loc.Key="MANUAL SETUP" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="18">
          <StackPanel>
            <TextBlock loc:Loc.Key="Use this only when automatic setup is unavailable. Point an MCP client at the Ask Key helper with the mcp argument."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="12">
              <StackPanel>
                <TextBlock x:Name="HelperPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="McpConfigText" Style="{StaticResource MonoText}" Margin="0,9,0,0"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button loc:Loc.Key="Copy MCP configuration" Style="{StaticResource PrimaryButton}" Click="CopyConfig_Click"/>
              <Button loc:Loc.Key="Check helper" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                      Click="CheckHelper_Click"/>
              <Button loc:Loc.Key="Open helper folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                      Click="OpenFolder_Click"/>
            </StackPanel>
            <TextBlock x:Name="CheckResultText" Style="{StaticResource MonoText}" Margin="0,10,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock loc:Loc.Key="WHAT AGENTS CAN DO" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="18">
          <StackPanel>
            <TextBlock loc:Loc.Key="Catalog, read, create, modify, delete and organize" Style="{StaticResource Headline}" FontSize="13"/>
            <TextBlock loc:Loc.Key="The MCP server exposes 19 tools. Hidden credentials never appear in the catalog. Every read follows the credential's permission: Allow, Ask, or Hidden. Writes always require a fresh approval and device-owner confirmation."
                       Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
            <TextBlock loc:Loc.Key="Command execution keeps the Agent’s stdout and stderr streaming to the caller. Ask Key never receives credential plaintext from the Agent; it injects the approved values into the target process environment or temporary files."
                       Style="{StaticResource SecondaryText}" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock loc:Loc.Key="Recovery" Style="{StaticResource Headline}" FontSize="12"/>
            <TextBlock loc:Loc.Key="If the App is not running, the helper reports NotRunning and Agents receive no credentials. Start Ask Key from the tray or sign in with Launch at login enabled."
                       Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
