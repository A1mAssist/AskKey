<UserControl x:Class="AskKeyApp.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
             FontFamily="{StaticResource UiFont}">
  <Grid Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,26" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock loc:Loc.Key="Settings" Style="{StaticResource PageTitle}"/>
        <TextBlock loc:Loc.Key="Choose how Ask Key starts and how much friction Agent access requires."
                   Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>

        <Border x:Name="BrokerFailurePanel" Style="{StaticResource InsetCard}" Margin="0,18,0,0"
                Background="{DynamicResource WarningSoft}" Visibility="Collapsed">
          <Grid>
            <StackPanel>
              <TextBlock loc:Loc.Key="Agent access needs attention" Style="{StaticResource Headline}" FontSize="13"/>
              <TextBlock x:Name="BrokerFailureText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button loc:Loc.Key="Retry" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="RetryBroker_Click"/>
          </Grid>
        </Border>

        <TextBlock loc:Loc.Key="GENERAL" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Launch at login" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Keep Ask Key ready for Agent requests after you sign in."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <CheckBox x:Name="LaunchCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Launch_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Global shortcut" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Open Ask Key from any application." Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <ComboBox x:Name="HotkeyCombo" Grid.Column="1" Style="{StaticResource FormComboBox}"
                        DisplayMemberPath="Label" SelectionChanged="Hotkey_SelectionChanged"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Timed read allowance" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Default window for “Allow for…” on read requests."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <ComboBox x:Name="AllowanceCombo" Grid.Column="1" Style="{StaticResource FormComboBox}"
                        DisplayMemberPath="Label" SelectionChanged="Allowance_SelectionChanged"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Appearance" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Match Windows or choose a fixed light or dark theme."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <ComboBox x:Name="AppearanceCombo" Grid.Column="1" Style="{StaticResource FormComboBox}"
                        SelectionChanged="Appearance_SelectionChanged">
                <ComboBoxItem loc:Loc.Key="System" Tag="system"/>
                <ComboBoxItem loc:Loc.Key="Light" Tag="light"/>
                <ComboBoxItem loc:Loc.Key="Dark" Tag="dark"/>
              </ComboBox>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Language" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Choose the language used by Ask Key."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource FormComboBox}"
                        SelectionChanged="Language_SelectionChanged">
                <ComboBoxItem loc:Loc.Key="System" Tag="system"/>
                <ComboBoxItem loc:Loc.Key="Simplified Chinese" Tag="zh-Hans"/>
                <ComboBoxItem loc:Loc.Key="English" Tag="en"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock loc:Loc.Key="SECURITY" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Confirm before reading a credential" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Ask for device-owner confirmation when an Agent reads a visible credential."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <CheckBox x:Name="ReadAuthCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="ReadAuth_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Access records" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock loc:Loc.Key="Keep up to 90 days of allowed, denied and expired Agent requests."
                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <Button loc:Loc.Key="Clear records" Style="{StaticResource SecondaryButton}" Grid.Column="1"
                      VerticalAlignment="Center" Click="ClearAccess_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock loc:Loc.Key="Local data" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="DataFolderText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <Button loc:Loc.Key="Open folder" Style="{StaticResource SecondaryButton}" Grid.Column="1"
                      VerticalAlignment="Center" Click="OpenDataFolder_Click"/>
            </Grid>
            <Border Style="{StaticResource ThinSeparator}"/>
            <StackPanel>
              <Grid Margin="16,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock loc:Loc.Key="Erase Local Data" Style="{StaticResource Headline}" FontSize="13"/>
                  <TextBlock loc:Loc.Key="Permanently deletes all credentials, groups and records. This cannot be undone."
                             Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="EraseButton" loc:Loc.Key="Erase…" Style="{StaticResource DangerButton}" Grid.Column="1"
                        VerticalAlignment="Center" Click="Erase_Click"/>
              </Grid>
              <Border x:Name="EraseConfirmPanel" Style="{StaticResource InsetCard}"
                      Background="{DynamicResource WarningSoft}" Margin="16,0,16,14" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="ErasePromptText" Style="{StaticResource SecondaryText}"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="EraseWordBox" Style="{StaticResource FormTextBox}" Width="200"
                             HorizontalAlignment="Left" TextChanged="EraseWord_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,8,0"
                              Click="EraseCancel_Click"/>
                      <Button x:Name="EraseConfirmButton" loc:Loc.Key="Authenticate and Erase"
                              Style="{StaticResource DangerSolidButton}" IsEnabled="False"
                              Click="EraseConfirm_Click"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="EraseFailureText" Foreground="{DynamicResource Warning}" FontSize="12"
                             TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock loc:Loc.Key="ABOUT" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
        <Border Style="{StaticResource Card}" Padding="16">
          <StackPanel>
            <TextBlock loc:Loc.Key="Ask Key for Windows 0.3.1" Style="{StaticResource Headline}" FontSize="13"/>
            <TextBlock loc:Loc.Key="Credentials are encrypted with Windows DPAPI. The Broker protocol is version 1; MCP uses 2024-11-05."
                       Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
            <TextBlock x:Name="AccessRecordFailureText" Foreground="{DynamicResource Warning}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
