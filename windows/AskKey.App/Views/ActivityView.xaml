<UserControl x:Class="AskKeyApp.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
             FontFamily="{StaticResource UiFont}">
  <Grid Background="{DynamicResource WindowBackground}">
    <Grid Margin="30,26,30,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock loc:Loc.Key="Activity" Style="{StaticResource PageTitle}"/>
          <TextBlock loc:Loc.Key="Pending requests, deleted credentials and recent Agent access."
                     Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
        </StackPanel>
        <Button x:Name="ClearRecordsButton" Grid.Column="1" loc:Loc.Key="Clear access records"
                Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="Collapsed" Click="ClearRecords_Click"/>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
        <Button x:Name="PendingTab" loc:Loc.Key="Pending" Style="{StaticResource SecondaryButton}"
                Padding="14,7" Margin="0,0,8,0" Click="PendingTab_Click"/>
        <Button x:Name="RecycleTab" loc:Loc.Key="Recycle Bin" Style="{StaticResource SecondaryButton}"
                Padding="14,7" Margin="0,0,8,0" Click="RecycleTab_Click"/>
        <Button x:Name="RecordsTab" loc:Loc.Key="Access records" Style="{StaticResource SecondaryButton}"
                Padding="14,7" Click="RecordsTab_Click"/>
      </StackPanel>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="PendingPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl x:Name="PendingList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Headline}" FontSize="13" TextWrapping="Wrap">
                          <Run Text="&quot;"/>
                          <Run Text="{Binding DisplayCredentialName, Mode=OneWay}"/>
                          <Run loc:Loc.Key="&quot; · "/>
                          <Run Text="{Binding Request.Operation, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Request.DisplayValue.CommandSummary}" Style="{StaticResource MonoText}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0">
                          <Run loc:Loc.Key="Requested by "/>
                          <Run Text="{Binding Request.CallerName, Converter={StaticResource LocalTextOrFallback}, ConverterParameter=Local Agent, Mode=OneWay}"/>
                          <Run loc:Loc.Key=" · expires "/>
                          <Run Text="{Binding ExpiresAt, Converter={StaticResource Timestamp}, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button loc:Loc.Key="Deny" Style="{StaticResource SecondaryButton}" Padding="10,6"
                                Tag="{Binding}" Click="DenyPending_Click"/>
                        <Button loc:Loc.Key="Review" Style="{StaticResource PrimaryButton}" Padding="10,6"
                                Margin="8,0,0,0" Tag="{Binding}" Click="ReviewPending_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="PendingEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock loc:Loc.Key="No pending requests" Style="{StaticResource Headline}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock loc:Loc.Key="New requests open a confirmation and remain here if deferred."
                         Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RecyclePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <ItemsControl x:Name="RecycleList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Headline}" FontSize="13"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                          <Run loc:Loc.Key="Deleted "/>
                          <Run Text="{Binding DeletedAt, Converter={StaticResource Timestamp}, Mode=OneWay}"/>
                          <Run loc:Loc.Key=" · restored credentials become available again immediately."/>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button loc:Loc.Key="Restore" Style="{StaticResource SecondaryButton}" Padding="10,6"
                                Tag="{Binding}" Click="Restore_Click"/>
                        <Button loc:Loc.Key="Delete permanently" Style="{StaticResource DangerButton}" Padding="10,6"
                                Margin="8,0,0,0" Tag="{Binding}" Click="PermanentDelete_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="RecycleEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock loc:Loc.Key="Recycle Bin is empty" Style="{StaticResource Headline}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock loc:Loc.Key="Deleted credentials stay here for 30 days." Style="{StaticResource SecondaryText}"
                         TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RecordsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <ItemsControl x:Name="RecordsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource BodyText}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0"/>
                      <Border Grid.Column="2" CornerRadius="6" Padding="7,3" Background="{DynamicResource SurfaceMuted}">
                        <TextBlock Text="{Binding Result}" FontSize="10" FontWeight="SemiBold"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="RecordsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock loc:Loc.Key="No access records yet" Style="{StaticResource Headline}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock loc:Loc.Key="Allowed, denied and expired Agent requests appear here."
                         Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="LockedPanel" Background="{DynamicResource WindowBackground}" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
            <TextBlock loc:Loc.Key="Unlock Ask Key" Style="{StaticResource PageTitle}" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock loc:Loc.Key="Activity history and the Recycle Bin are protected by device-owner confirmation."
                       Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button loc:Loc.Key="Unlock management" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    HorizontalAlignment="Center" Click="Unlock_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
