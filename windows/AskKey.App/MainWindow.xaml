<Window x:Class="AskKeyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AskKeyApp"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        loc:Loc.Key="Ask Key"
        Icon="Assets/AppIcon.png"
        Width="1120" Height="740" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Text}"
        Closing="Window_Closing">
  <!-- WindowChrome hides the native frame while DWM keeps system minimize/maximize transitions. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="222"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource TitleBarBackground}"
            BorderBrush="{DynamicResource TitleBarBorder}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image Width="28" Height="28" Source="Assets/AppIcon.png" Stretch="Uniform"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock loc:Loc.Key="Ask Key" FontFamily="{StaticResource DisplayFont}" FontSize="14.5"
                       FontWeight="SemiBold"/>
            <TextBlock loc:Loc.Key="Credentials for Agents" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiary}" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}"
                  loc:Loc.ToolTipKey="Minimize"
                  AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                  Click="Minimize_Click">
            <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyph}" FontSize="10"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                  loc:Loc.ToolTipKey="Maximize"
                  AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                  Click="Maximize_Click">
            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarCloseButton}"
                  loc:Loc.ToolTipKey="Close"
                  AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                  Click="Close_Click">
            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="11"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackground}">
      <DockPanel Margin="16,16,14,14">
        <StackPanel DockPanel.Dock="Top">
          <Border x:Name="AgentStatusPill" Style="{StaticResource InsetCard}" Margin="0,0,0,12"
                  Padding="10,8" Cursor="Hand" MouseLeftButtonUp="AgentStatusPill_Click">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="AgentStatusDot" Width="7" Height="7" Fill="{DynamicResource Success}"
                       VerticalAlignment="Center"/>
              <TextBlock x:Name="AgentStatusText" loc:Loc.Key="Agent access running" Style="{StaticResource SecondaryText}"
                         Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <ListBox x:Name="NavList" Style="{StaticResource NavList}" SelectionChanged="NavList_SelectionChanged">
            <ListBoxItem Style="{StaticResource NavItem}" Tag="Credentials">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyph}" FontSize="14"/>
                <TextBlock loc:Loc.Key="Credentials" Margin="9,0,0,0" FontSize="13"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource NavItem}" Tag="Activity">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyph}" FontSize="14"/>
                  <TextBlock loc:Loc.Key="Activity" Margin="9,0,0,0" FontSize="13"/>
                </StackPanel>
                <Border x:Name="PendingBadge" Grid.Column="1" Style="{StaticResource Badge}"
                        Visibility="Collapsed" VerticalAlignment="Center">
                  <TextBlock x:Name="PendingBadgeText" Text="0" Foreground="White" FontSize="10"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource NavItem}" Tag="AgentAccess">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="14"/>
                <TextBlock loc:Loc.Key="Agent access" Margin="9,0,0,0" FontSize="13"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource NavItem}" Tag="Settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="14"/>
                <TextBlock loc:Loc.Key="Settings" Margin="9,0,0,0" FontSize="13"/>
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource ThinSeparator}" Margin="2,12,2,10"/>
          <Button x:Name="QuitButton" Style="{StaticResource SecondaryButton}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="9,7" Foreground="{DynamicResource TextSecondary}" FontWeight="Normal"
                  loc:Loc.ToolTipKey="Quit Ask Key"
                  AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                  Click="Quit_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyph}" FontSize="14"/>
              <TextBlock loc:Loc.Key="Quit Ask Key" Margin="8,0,0,0" FontSize="12"/>
            </StackPanel>
          </Button>
          <TextBlock loc:Loc.Key="v0.1.0 · Windows" Style="{StaticResource CaptionText}" Margin="8,5,0,0"/>
        </StackPanel>

        <ScrollViewer Style="{StaticResource ContentScrollViewer}" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="6,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock loc:Loc.Key="GROUPS" Style="{StaticResource SectionLabel}"/>
              <Button Grid.Column="1" Content="+" Style="{StaticResource GhostButton}" Padding="4,0"
                      FontSize="16" Click="NewGroup_Click" loc:Loc.ToolTipKey="New group"/>
            </Grid>
            <ListBox x:Name="GroupList" Style="{StaticResource NavList}" SelectionChanged="GroupList_SelectionChanged"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <ContentControl x:Name="ContentHost" Grid.Row="1" Grid.Column="1"/>
  </Grid>
</Window>
