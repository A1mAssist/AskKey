<Window x:Class="AskKeyApp.CredentialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="Credential" Width="700" Height="780" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,20">
        <TextBlock x:Name="TitleText" loc:Loc.Key="New credential" Style="{StaticResource PageTitle}" FontSize="23"/>
        <TextBlock x:Name="SubtitleText" loc:Loc.Key="Keep the material an Agent needs together."
                   Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>

        <TextBlock loc:Loc.Key="NAME" Style="{StaticResource SectionLabel}" Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}"/>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock loc:Loc.Key="TYPE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeCombo" Style="{StaticResource FormComboBox}" SelectionChanged="Type_SelectionChanged">
              <ComboBoxItem loc:Loc.Key="Text" Tag="text"/>
              <ComboBoxItem loc:Loc.Key="File" Tag="file"/>
              <ComboBoxItem loc:Loc.Key="Bundle" Tag="bundle"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock loc:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <ComboBox x:Name="PermissionCombo" Style="{StaticResource FormComboBox}">
              <ComboBoxItem loc:Loc.Key="Ask every time" Tag="ask"/>
              <ComboBoxItem loc:Loc.Key="Allow" Tag="allowed"/>
              <ComboBoxItem loc:Loc.Key="Hidden" Tag="hidden"/>
            </ComboBox>
          </StackPanel>
        </Grid>

        <TextBlock loc:Loc.Key="GROUP" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
        <ComboBox x:Name="GroupCombo" Style="{StaticResource EditableFormComboBox}" IsEditable="True"/>

        <Border x:Name="ExistingSecretPanel" Style="{StaticResource InsetCard}" Margin="0,20,0,0"
                Padding="14" Visibility="Collapsed">
          <Grid>
            <StackPanel>
              <TextBlock loc:Loc.Key="Contents stay hidden" Style="{StaticResource Headline}" FontSize="13"/>
              <TextBlock loc:Loc.Key="Changing the name, group, permission or notes does not reveal plaintext."
                         Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button loc:Loc.Key="Authenticate to edit contents" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Authenticate_Click"/>
          </Grid>
        </Border>

        <StackPanel x:Name="TextPanel" Margin="0,18,0,0">
          <TextBlock loc:Loc.Key="VALUE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
          <Grid>
            <PasswordBox x:Name="ValueBox" Padding="10,8" FontSize="13" BorderBrush="{DynamicResource Border}"
                         BorderThickness="1"/>
            <TextBox x:Name="ValuePlainBox" Style="{StaticResource FormTextBox}" Visibility="Collapsed"/>
            <Button loc:Loc.Key="Show" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,4,0" Click="ToggleValue_Click"/>
          </Grid>
          <TextBlock loc:Loc.Key="ENVIRONMENT VARIABLE (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
          <TextBox x:Name="EnvironmentBox" Style="{StaticResource FormTextBox}"
                   loc:Loc.ToolTipKey="For example: OPENAI_API_KEY"/>
        </StackPanel>

        <StackPanel x:Name="FilePanel" Margin="0,18,0,0" Visibility="Collapsed">
          <TextBlock loc:Loc.Key="FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
          <Border Style="{StaticResource InsetCard}" Padding="14">
            <Grid>
              <StackPanel>
                <TextBlock x:Name="FileNameText" loc:Loc.Key="No file selected" Style="{StaticResource Headline}" FontSize="13"/>
                <TextBlock x:Name="FileSizeText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
              </StackPanel>
              <Button loc:Loc.Key="Choose file" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Click="ChooseFile_Click"/>
            </Grid>
          </Border>
          <TextBlock loc:Loc.Key="TEMPORARY FILE VARIABLE (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
          <TextBox x:Name="FileEnvironmentBox" Style="{StaticResource FormTextBox}"
                   loc:Loc.ToolTipKey="For example: GOOGLE_APPLICATION_CREDENTIALS"/>
        </StackPanel>

        <StackPanel x:Name="BundlePanel" Margin="0,18,0,0" Visibility="Collapsed">
          <Grid>
            <TextBlock loc:Loc.Key="COMPONENTS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button loc:Loc.Key="Add text" Style="{StaticResource GhostButton}" Click="AddTextComponent_Click"/>
              <Button loc:Loc.Key="Add file" Style="{StaticResource GhostButton}" Click="AddFileComponent_Click"/>
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="ComponentList" Margin="0,7,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource InsetCard}" Padding="10" Margin="0,0,0,7">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource FormTextBox}" FontWeight="SemiBold"/>
                      <Button Grid.Column="1" loc:Loc.Key="Remove" Style="{StaticResource GhostButton}"
                              Margin="8,0,0,0" Tag="{Binding}" Click="RemoveComponent_Click"/>
                    </Grid>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,7,0,0"
                             Visibility="{Binding TextVisibility}"/>
                    <Grid Margin="0,7,0,0" Visibility="{Binding FileVisibility}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding FileDescription}" Style="{StaticResource SecondaryText}"
                                 VerticalAlignment="Center"/>
                      <Button Grid.Column="1" loc:Loc.Key="Choose" Style="{StaticResource SecondaryButton}"
                              Tag="{Binding}" Click="ChooseComponentFile_Click"/>
                    </Grid>
                    <TextBox Text="{Binding Mapping, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,7,0,0"
                             loc:Loc.ToolTipKey="Environment variable or temporary-file variable"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock loc:Loc.Key="INSTRUCTIONS FOR AGENT (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
        <TextBox x:Name="InstructionsBox" Style="{StaticResource FormTextBox}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="58" VerticalScrollBarVisibility="Auto"/>
        <TextBlock loc:Loc.Key="PRIVATE NOTES (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource FormTextBox}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto"/>
        <TextBlock loc:Loc.Key="EXPIRY (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
        <TextBox x:Name="ExpiryBox" Style="{StaticResource FormTextBox}" loc:Loc.ToolTipKey="YYYY-MM-DD"/>
        <TextBlock loc:Loc.Key="Leave empty for no expiry. Ask Key hides expired credentials from Agents."
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Warning}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Surface}" Padding="22,12">
      <Grid>
        <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                Click="Cancel_Click"/>
        <Button x:Name="SaveButton" loc:Loc.Key="Save credential" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" IsDefault="True" Click="Save_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>

