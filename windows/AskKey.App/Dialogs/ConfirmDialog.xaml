<Window x:Class="AskKeyApp.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="Ask Key"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}">
  <Border Padding="24">
    <StackPanel>
      <TextBlock loc:Loc.Key="Confirm with Ask Key" Style="{StaticResource PageTitle}" FontSize="20"/>
      <TextBlock x:Name="ReasonText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
      <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
        <TextBlock Style="{StaticResource CaptionText}"
                   loc:Loc.Key="Ask Key is asking you to confirm this action. Agents never see the stored value."/>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click"/>
        <Button loc:Loc.Key="Confirm" Style="{StaticResource PrimaryButton}" IsDefault="True"
                Click="Confirm_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
