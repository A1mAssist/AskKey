<Window x:Class="AskKeyApp.ImportCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="Import from File" Width="780" Height="800" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,20">
        <TextBlock loc:Loc.Key="Import from File" Style="{StaticResource PageTitle}" FontSize="23"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>

        <TextBlock loc:Loc.Key="NAME" Style="{StaticResource SectionLabel}" Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}" TextChanged="Name_TextChanged"/>
        <TextBlock loc:Loc.Key="Defaults to the file name; you can change it."
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>

        <StackPanel x:Name="PermissionPanel" Margin="0,18,0,0">
          <TextBlock loc:Loc.Key="AGENT PERMISSION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
          <ComboBox x:Name="PermissionCombo" Style="{StaticResource FormComboBox}"
                    SelectionChanged="Permission_SelectionChanged">
            <ComboBoxItem loc:Loc.Key="Ask every time" Tag="ask"/>
            <ComboBoxItem loc:Loc.Key="Allow" Tag="allowed"/>
            <ComboBoxItem loc:Loc.Key="Hidden" Tag="hidden"/>
          </ComboBox>
        </StackPanel>
        <TextBlock x:Name="PermissionNote" Style="{StaticResource CaptionText}"
                   Margin="0,5,0,0" Visibility="Collapsed"/>

        <Border x:Name="ConflictPanel" Style="{StaticResource InsetCard}"
                Background="{DynamicResource WarningSoft}" Margin="0,16,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="ConflictText" Style="{StaticResource SecondaryText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <RadioButton x:Name="SkipChoice" GroupName="ImportConflict" IsChecked="True"
                           VerticalAlignment="Center" Checked="ConflictChoice_Changed"/>
              <RadioButton x:Name="ReplaceChoice" GroupName="ImportConflict" Margin="18,0,0,0"
                           VerticalAlignment="Center" Checked="ConflictChoice_Changed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ContentsHeader" Style="{StaticResource SectionLabel}" Margin="0,22,0,6"/>
        <Border Style="{StaticResource Card}" Padding="10">
          <ItemsControl x:Name="RowList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource InsetCard}" Padding="12" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock loc:Loc.Key="COMPONENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ValueDisplay}" Style="{StaticResource MonoText}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="{Binding RevealLabel}" Tag="{Binding}" Click="RevealRow_Click"
                              Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                    <TextBlock Text="{Binding MappingLabel}" Style="{StaticResource SectionLabel}" Margin="0,9,0,5"/>
                    <TextBox Text="{Binding Mapping, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             loc:Loc.ToolTipKey="Environment variable or temporary-file variable"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock loc:Loc.Key="The original file is never modified. Ask Key stores the imported material encrypted."
                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Warning}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Surface}" Padding="22,12">
      <Grid>
        <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                Click="Cancel_Click"/>
        <Button x:Name="SaveButton" loc:Loc.Key="Import as 1 credential" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" IsDefault="True" Click="Save_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
