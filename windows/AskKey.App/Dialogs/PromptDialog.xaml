<Window x:Class="AskKeyApp.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="Ask Key" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="{StaticResource UiFont}">
  <Border Padding="24">
    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource Headline}" FontSize="18"/>
      <TextBlock x:Name="PromptText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
      <TextBox x:Name="InputBox" Style="{StaticResource FormTextBox}" Margin="0,14,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click"/>
        <Button loc:Loc.Key="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
