<Window x:Class="AskKeyApp.CredentialTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="New credential"
        Width="720" Height="565" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}">
  <Window.Resources>
    <Style x:Key="TemplateChoiceButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="TemplateChoice">
      <Button Style="{StaticResource TemplateChoiceButton}" Tag="{Binding}" Click="Template_Click"
              AutomationProperties.Name="{Binding Title}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}"
                       Foreground="{DynamicResource Accent}" FontSize="15"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Headline}" FontSize="13"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="11"
                     Foreground="{DynamicResource TextTertiary}"/>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Style="{StaticResource ContentScrollViewer}">
      <StackPanel Margin="28,24,20,14">
        <TextBlock loc:Loc.Key="What do you want to save?" Style="{StaticResource PageTitle}" FontSize="23"/>
        <TextBlock loc:Loc.Key="Choose the closest template. You can add or remove items later."
                   Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
        <ItemsControl x:Name="PresetList" ItemTemplate="{StaticResource TemplateChoice}" Margin="0,20,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl x:Name="CustomList" ItemTemplate="{StaticResource TemplateChoice}" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Surface}" Padding="24,12">
      <Button loc:Loc.Key="Cancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
              IsCancel="True" Click="Cancel_Click"/>
    </Border>
  </Grid>
</Window>
