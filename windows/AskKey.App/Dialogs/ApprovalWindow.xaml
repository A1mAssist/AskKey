<Window x:Class="AskKeyApp.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AskKeyApp"
        loc:Loc.Key="Ask Key approval" Width="640" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Text}" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock loc:Loc.Key="Agent request" Style="{StaticResource PageTitle}" FontSize="22"/>
        <TextBlock x:Name="RequesterText" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource InsetCard}" VerticalAlignment="Top" Padding="10,7">
        <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionText}"/>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18">
      <StackPanel>
        <TextBlock x:Name="ActionText" Style="{StaticResource Headline}" FontSize="17" TextWrapping="Wrap"/>
        <Border x:Name="CommandCard" Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="12,10">
          <TextBlock x:Name="CommandText" Style="{StaticResource MonoText}" TextWrapping="Wrap"/>
        </Border>
        <TextBlock x:Name="WorkingDirectoryText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
        <TextBlock x:Name="MappingsText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Border x:Name="FileCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18"
            Visibility="Collapsed">
      <StackPanel>
        <TextBlock loc:Loc.Key="FROZEN FILE WRITE" Style="{StaticResource SectionLabel}"/>
        <TextBlock x:Name="FileSummaryText" Style="{StaticResource BodyText}" Margin="0,7,0,0"/>
        <TextBlock x:Name="FileDigestText" Style="{StaticResource MonoText}" Margin="0,6,0,0"/>
        <TextBlock loc:Loc.Key="The approved bytes are fixed to this digest. The Agent cannot substitute another file after approval."
                   Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FileRevealHint" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RevealFileButton" loc:Loc.Key="View file" Style="{StaticResource GhostButton}"
                    Click="RevealFile_Click"/>
            <Button x:Name="HideFileButton" loc:Loc.Key="Hide file" Style="{StaticResource GhostButton}"
                    Visibility="Collapsed" Margin="4,0,0,0" Click="HideFile_Click"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="FileRevealBox" Style="{StaticResource FormTextBox}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" Visibility="Collapsed"
                 VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
        <TextBlock x:Name="FileRevealError" Foreground="{DynamicResource Warning}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <Button x:Name="DetailsButton" Grid.Row="3" Style="{StaticResource GhostButton}"
            HorizontalAlignment="Left" Margin="0,10,0,0" Click="Details_Click">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="DetailsChevron" Text="›" FontSize="15" Margin="0,0,5,0" VerticalAlignment="Center"/>
        <TextBlock loc:Loc.Key="Details" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>

    <Border x:Name="DetailsCard" Grid.Row="4" Style="{StaticResource InsetCard}" Margin="0,6,0,0"
            Padding="14" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
        <StackPanel x:Name="DetailsPanel">
          <StackPanel x:Name="DetailsRows"/>
          <Border x:Name="ValueRevealCard" Style="{StaticResource InsetCard}" Margin="0,12,0,0"
                  Padding="12" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <TextBlock loc:Loc.Key="Value" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="RevealValueButton" loc:Loc.Key="Authenticate to View"
                          Style="{StaticResource GhostButton}" Click="RevealValue_Click"/>
                  <Button x:Name="HideValueButton" loc:Loc.Key="Hide value"
                          Style="{StaticResource GhostButton}" Visibility="Collapsed"
                          Margin="4,0,0,0" Click="HideValue_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ValueMaskedText" Text="••••••" Style="{StaticResource SecondaryText}"
                         Margin="0,6,0,0"/>
              <TextBox x:Name="RevealedValueBox" Style="{StaticResource FormTextBox}" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" Visibility="Collapsed"
                       VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
              <TextBlock x:Name="ValueRevealError" Foreground="{DynamicResource Warning}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource InsetCard}" Margin="0,12,0,0" Padding="12,10">
      <StackPanel>
        <TextBlock loc:Loc.Key="Only approve a request you understand. Values stay hidden until you authenticate to view them."
                   Style="{StaticResource SecondaryText}"/>
        <TextBlock loc:Loc.Key="Close this window or press Esc to decide later."
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="6" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button loc:Loc.Key="Deny" Style="{StaticResource SecondaryButton}" Click="Deny_Click" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="TimedButton" loc:Loc.Key="Allow for 30 minutes" Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0" Click="Timed_Click"/>
        <Button x:Name="AllowButton" loc:Loc.Key="Allow once" Style="{StaticResource PrimaryButton}"
                IsDefault="True" Click="Allow_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
