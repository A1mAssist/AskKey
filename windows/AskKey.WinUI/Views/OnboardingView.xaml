<UserControl
    x:Class="AskKeyApp.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp">
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <ScrollViewer Style="{StaticResource ContentScrollViewerStyle}">
      <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36,34,36,34">
        <Image Width="54" Height="54" Source="Assets/AppIcon.png" Stretch="Uniform"
               HorizontalAlignment="Left"/>
        <TextBlock local:Loc.Key="Keep credentials away from Agents until you approve" Style="{StaticResource PageTitleStyle}"
                   Margin="0,20,0,0"/>
        <TextBlock local:Loc.Key="Ask Key stores credentials locally, gives an Agent only the one it needs, and asks you before any read or write."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="0">
          <StackPanel>
            <Grid Margin="18,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="24" Height="24" CornerRadius="12" Background="{ThemeResource AccentSoftBrush}">
                <TextBlock Text="1" Foreground="{ThemeResource AccentBrush}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock local:Loc.Key="Save your first credential" Style="{StaticResource HeadlineStyle}" FontSize="14"/>
                <TextBlock local:Loc.Key="Create a text credential, store a file, or import an .env bundle."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button local:Loc.Key="Create credential" Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click"/>
                  <Button local:Loc.Key="Import file" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="Import_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource LineBrush}"/>
            <Grid Margin="18,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="24" Height="24" CornerRadius="12" Background="{ThemeResource SurfaceMutedBrush}">
                <TextBlock Text="2" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock local:Loc.Key="Connect an Agent" Style="{StaticResource HeadlineStyle}" FontSize="14"/>
                <TextBlock local:Loc.Key="Point an MCP client at Helpers\askkey.exe mcp. The helper only reaches this App over a local named pipe."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <Button local:Loc.Key="Open Agent access" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Click="Connect_Click"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="18,16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock local:Loc.Key="Protect with a passphrase" Style="{StaticResource HeadlineStyle}" FontSize="14"/>
                <TextBlock x:Name="PassphraseHint" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="PassphraseToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                            IsChecked="True" Click="Passphrase_Click"/>
</Grid>
            <StackPanel x:Name="PassphraseFields" Margin="0,12,0,0">
              <PasswordBox x:Name="PassphraseBox" PlaceholderText="Passphrase (at least 8 characters)"/>
              <PasswordBox x:Name="PassphraseConfirmBox" PlaceholderText="Confirm the passphrase" Margin="0,8,0,0"/>
              <TextBlock local:Loc.Key="If you forget it, the library cannot be opened. There is no recovery."
                         Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <ToggleSwitch x:Name="LaunchCheck" IsOn="True" Margin="0,18,0,0"/>
        <Button local:Loc.Key="Continue to Ask Key" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0"
                HorizontalAlignment="Left" Click="Continue_Click"/>
        <TextBlock local:Loc.Key="Ask Key stores data under your Windows user profile."
                   Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
