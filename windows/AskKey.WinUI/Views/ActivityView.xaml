<UserControl
    x:Class="AskKeyApp.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp">
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="{StaticResource PageMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock local:Loc.Key="Activity" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock local:Loc.Key="Pending requests, deleted credentials and recent Agent access."
                     Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
        </StackPanel>
        <Button x:Name="ClearRecordsButton" Grid.Column="1" local:Loc.Key="Clear access records"
                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="Collapsed" Click="ClearRecords_Click"/>
      </Grid>

      <Border Grid.Row="1" Background="{ThemeResource SurfaceMutedBrush}" CornerRadius="8"
              Padding="2" HorizontalAlignment="Left" Margin="0,18,0,14">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="PendingTab" local:Loc.Key="Pending" Style="{StaticResource SegmentButtonStyle}"
                  Click="PendingTab_Click"/>
          <Button x:Name="RecycleTab" local:Loc.Key="Recycle Bin" Style="{StaticResource SegmentButtonStyle}"
                  Click="RecycleTab_Click"/>
          <Button x:Name="RecordsTab" local:Loc.Key="Access records" Style="{StaticResource SegmentButtonStyle}"
                  Click="RecordsTab_Click"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="PendingPanel" Style="{StaticResource ContentScrollViewerStyle}">
          <StackPanel>
            <ItemsControl x:Name="PendingList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource HeadlineStyle}" FontSize="13" TextWrapping="Wrap">
                          <Run Text="&quot;"/><Run Text="{Binding DisplayCredentialName}"/><Run local:Loc.Key="&quot; · "/>
                          <Run Text="{Binding Request.Operation}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Request.DisplayValue.CommandSummary}" Style="{StaticResource MonoTextStyle}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0">
                          <Run local:Loc.Key="Requested by "/><Run Text="{Binding Request.CallerName, Converter={StaticResource LocalTextOrFallback}, ConverterParameter='Local Agent'}"/>
                          <Run local:Loc.Key=" · expires "/><Run Text="{Binding ExpiresAt, Converter={StaticResource Timestamp}}"/>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button local:Loc.Key="Deny" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6"
                                Tag="{Binding}" Click="DenyPending_Click"/>
                        <Button local:Loc.Key="Review" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"
                                Margin="8,0,0,0" Tag="{Binding}" Click="ReviewPending_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="PendingEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock local:Loc.Key="No pending requests" Style="{StaticResource HeadlineStyle}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock local:Loc.Key="New requests open a confirmation and remain here if deferred."
                         Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RecyclePanel" Style="{StaticResource ContentScrollViewerStyle}" Visibility="Collapsed">
          <StackPanel>
            <ItemsControl x:Name="RecycleList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadlineStyle}" FontSize="13"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                          <Run local:Loc.Key="Deleted "/><Run Text="{Binding DeletedAt, Converter={StaticResource Timestamp}}"/>
                          <Run local:Loc.Key=" · restored credentials become available again immediately."/>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button local:Loc.Key="Restore" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6"
                                Tag="{Binding}" Click="Restore_Click"/>
                        <Button local:Loc.Key="Delete permanently" Style="{StaticResource DangerButtonStyle}" Padding="10,6"
                                Margin="8,0,0,0" Tag="{Binding}" Click="PermanentDelete_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="RecycleEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock local:Loc.Key="Recycle Bin is empty" Style="{StaticResource HeadlineStyle}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock local:Loc.Key="Deleted credentials stay here for 30 days." Style="{StaticResource SecondaryTextStyle}"
                         TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RecordsPanel" Style="{StaticResource ContentScrollViewerStyle}" Visibility="Collapsed">
          <StackPanel>
            <ItemsControl x:Name="RecordsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource BodyTextStyle}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0"/>
                      <Border Grid.Column="2" CornerRadius="8" Padding="7,3" Background="{ThemeResource SurfaceMutedBrush}">
                        <TextBlock Text="{Binding Result}" FontSize="10" FontWeight="SemiBold"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="RecordsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock local:Loc.Key="No access records yet" Style="{StaticResource HeadlineStyle}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock local:Loc.Key="Allowed, denied and expired Agent requests appear here."
                         Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="LockedPanel" Background="{ThemeResource WindowBackgroundBrush}" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
            <TextBlock local:Loc.Key="Unlock Ask Key" Style="{StaticResource PageTitleStyle}" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock local:Loc.Key="Activity history and the Recycle Bin are protected by device-owner confirmation."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button local:Loc.Key="Unlock management" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"
                    HorizontalAlignment="Center" Click="Unlock_Click"/>
          </StackPanel>
        </Border>
      </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
