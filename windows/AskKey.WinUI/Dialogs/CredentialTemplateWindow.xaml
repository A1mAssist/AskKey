<Window
    x:Class="AskKeyApp.CredentialTemplateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AskKeyApp"
    >
  <Grid Background="{ThemeResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Style="{StaticResource ContentScrollViewerStyle}">
      <StackPanel Margin="28,24,28,20">
        <TextBlock local:Loc.Key="New credential" Style="{StaticResource PageTitleStyle}" FontSize="23"/>
        <TextBlock local:Loc.Key="Start with a shape for the material your Agent needs."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
        <TextBlock local:Loc.Key="RECOMMENDED" Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,7"/>
        <ItemsControl HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="PresetList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                      Margin="0,0,0,8" Padding="14,10" Click="Template_Click">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyphStyle}" FontSize="17" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineStyle}" FontSize="13"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock local:Loc.Key="CUSTOM" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,7"/>
        <ItemsControl HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="CustomList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                      Padding="14,10" Click="Template_Click">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyphStyle}" FontSize="17" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineStyle}" FontSize="13"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock local:Loc.Key="You can change every field after choosing a shape." Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0"
            Background="{ThemeResource SurfaceBrush}" Padding="22,12">
      <Button local:Loc.Key="Cancel" Style="{StaticResource SecondaryButtonStyle}"
              HorizontalAlignment="Left" Click="Cancel_Click"/>
    </Border>
  </Grid>
</Window>
